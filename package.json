{
  "name": "yujian",
  "version": "1.0.0",
  "private": true,
  "description": "玉笺 Markdown 编辑器 — 所见即所得，可切源码",
  "main": "./out/main/index.js",
  "author": "玉笺",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs preview",
    "start": "node scripts/dev.mjs preview",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release": "electron-vite build && electron-builder --win --publish=onTag",
    "release:mac": "electron-vite build && electron-builder --mac --publish=onTag",
    "release:linux": "electron-vite build && electron-builder --linux --publish=onTag"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "buffer": "^6.0.3",
    "chokidar": "^4.0.3",
    "codemirror": "^6.0.2",
    "diff": "^7.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.4",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.6",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.yujian.app",
    "productName": "玉笺",
    "copyright": "Copyright © 2026 玉笺",
    "icon": "build/icon.png",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${name}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "玉笺",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "forceCodeSigning": false,
      "notarize": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "liu-li-huan-ying",
        "repo": "yujian",
        "releaseType": "release",
        "vPrefixedTagName": true
      }
    ]
  }
}
